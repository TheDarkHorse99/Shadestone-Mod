	"authors": [
		"TheDarkHorse99"
	],
	"contact": {
		"homepage": "https://github.com/TheDarkHorse99/Shadestone-Mod",
		"sources": "https://github.com/TheDarkHorse99/Shadestone-Mod"
	},
	"license": "CC0-1.0",
